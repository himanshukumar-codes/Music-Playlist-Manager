# ============================================================================
# Environment Configuration
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# EMAIL & OTP CONFIGURATION (Required for production)
# ============================================================================

# Option 1: Gmail SMTP
# Enable 2-Step Verification, then create an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_PROVIDER=smtp
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Option 2: Custom SMTP Server
# Use EMAIL_PROVIDER=smtp and uncomment these settings instead of EMAIL_SERVICE
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-server.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=your-email@your-domain.com
# EMAIL_PASSWORD=your-password

# Option 3: SendGrid
# Use EMAIL_PROVIDER=sendgrid and a verified sender identity
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_USER=your-verified-sender@example.com

# ============================================================================
# DEVELOPMENT MODE
# ============================================================================

# Set to 'true' to disable email and log OTP to server console instead
# ONLY for development! Set to 'false' in production
DEV_EMAIL_FALLBACK=true

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Backend server port (default: 4000)
PORT=4000

# ============================================================================
# FRONTEND CONFIGURATION (Optional)
# ============================================================================

# For production builds, set the backend API URL
# VITE_API_URL=https://your-api-domain.com

# Enable debug mode for development
# VITE_DEBUG_MODE=false
